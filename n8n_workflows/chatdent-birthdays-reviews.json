{
  "name": "ChatDENT birthdays and reviews",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
  "pinData": {},
  "versionId": "1",
  "tags": [],
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "nodes": [
    {
      "parameters": {
        "content": "## Birthdays\n\nClinic-local 09:00 (workflow timezone Asia/Kolkata): birthday WhatsApp once per clinic year.\nGoogle review requests are sent only from ChatDENT \u2192 patient details (treatment completed + Send review request).",
        "height": 280,
        "width": 360,
        "color": 4
      },
      "id": "note-out-1",
      "name": "Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -380,
        160
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "sched-bday",
      "name": "Daily 9am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://pocketbase:8090/api/leads/due-birthdays?days=0",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Booking-Token",
              "value": "={{ $env.N8N_BOOKING_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-bdays",
      "name": "Get due birthdays",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "function n8nEnv(name, fallback) {\n  try {\n    const v = $env[name];\n    if (v != null && String(v).trim() !== '') return String(v).trim();\n  } catch (e) {}\n  return fallback == null ? '' : fallback;\n}\n\nconst body = $input.first().json || {};\nconst clinic = body.clinicName || 'the clinic';\nconst url = body.googleReviewUrl || '';\nconst tpl = body.template || '';\nconst people = body.people || [];\nif (!people.length) return [];\nconst isReview = people[0].reviewAskCount !== undefined;\nreturn people.map(function (p) {\n  const text = String(p.whatsappText || '').trim() || String(tpl)\n    .replace(/\\{name\\}/g, p.name || '')\n    .replace(/\\{clinic\\}/g, clinic)\n    .replace(/\\{reviewUrl\\}/g, url);\n  return {\n    json: {\n      evoBase: n8nEnv('N8N_EVO_BASE', 'http://evolution-api:8080'),\n      evoKey: n8nEnv('EVOLUTION_API_KEY', ''),\n      evoInstance: n8nEnv('WHATSAPP_SESSION_ID', 'clinic_default'),\n      number: String(p.phone || '').replace(/\\D/g, ''),\n      reply: text,\n      phone: String(p.phone || '').replace(/\\D/g, ''),\n      name: p.name || '',\n      type: isReview ? 'review_asked' : 'birthday_sent'\n    }\n  };\n});\n"
      },
      "id": "code-split-bday",
      "name": "Split birthdays",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 15,
        "unit": "seconds"
      },
      "id": "wait-out",
      "name": "Wait before outreach",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        640,
        200
      ],
      "webhookId": "wait-out"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($json.evoBase || 'http://evolution-api:8080') + '/message/sendText/' + ($json.evoInstance || 'clinic_default') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $json.evoKey || $env.EVOLUTION_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.number, text: $json.reply }) }}",
        "options": {}
      },
      "id": "http-evo-out",
      "name": "Send outreach WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        340
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://pocketbase:8090/api/leads/ai-event",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Booking-Token",
              "value": "={{ $env.N8N_BOOKING_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $('Wait before outreach').item.json.phone, name: $('Wait before outreach').item.json.name, type: $('Wait before outreach').item.json.type }) }}",
        "options": {}
      },
      "id": "http-mark-out",
      "name": "Mark outreach sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        340
      ]
    }
  ],
  "connections": {
    "Daily 9am": {
      "main": [
        [
          {
            "node": "Get due birthdays",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get due birthdays": {
