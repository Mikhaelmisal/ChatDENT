            "index": 0
          }
        ]
      ]
    },
    "Split birthdays": {
      "main": [
        [
          {
            "node": "Wait before outreach",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait before outreach": {
      "main": [
        [
          {
            "node": "Send outreach WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send outreach WhatsApp": {
      "main": [
        [
          {
            "node": "Mark outreach sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}