{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "chatdent-flutter",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "chatdent-flutter (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "chatdent-flutter (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            // Web run with COOP/COEP headers — required for dicom_toolkit's
            // WASM threading (SharedArrayBuffer). Mirrors the web/_headers
            // file that Cloudflare Pages serves in production. Use this
            // config (not the default) when testing DICOM features on web.
            "name": "chatdent-flutter (web, COOP/COEP)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "args": [
                "--web-header=Cross-Origin-Opener-Policy=same-origin",
                "--web-header=Cross-Origin-Embedder-Policy=require-corp"
            ]
        }
    ]
}